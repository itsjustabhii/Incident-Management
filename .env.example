# ==============================================================================
# Enterprise Incident & Support Management Platform — Root .env.example
# Copy this file to .env and fill in real values.
# NEVER commit a .env file with real credentials to source control.
# ==============================================================================

# ── Node environment ──────────────────────────────────────────────────────────
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Connection string used by Prisma and the server
POSTGRES_USER=incident_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=incident_management
POSTGRES_PORT=5432
DATABASE_URL=postgresql://incident_user:change_me_in_production@localhost:5432/incident_management

# Test database (separate DB so tests never touch dev data)
TEST_DATABASE_URL=postgresql://incident_user:change_me_in_production@localhost:5432/incident_management_test

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Full URL alternative (takes priority if set)
REDIS_URL=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_random_hex_access
JWT_REFRESH_SECRET=replace_with_64_byte_random_hex_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=5000
SERVER_HOST=0.0.0.0
# Comma-separated allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000

# ── Client ────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_WS_URL=http://localhost:5000
VITE_APP_NAME=IncidentHub

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=./uploads
# Set to 's3' in production
STORAGE_DRIVER=local

# ── AWS S3 (production storage) ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── SLA defaults (minutes) ────────────────────────────────────────────────────
SLA_CRITICAL_RESPONSE_MINUTES=60
SLA_CRITICAL_RESOLUTION_MINUTES=240
SLA_HIGH_RESPONSE_MINUTES=240
SLA_HIGH_RESOLUTION_MINUTES=480
SLA_MEDIUM_RESPONSE_MINUTES=480
SLA_MEDIUM_RESOLUTION_MINUTES=1440
SLA_LOW_RESPONSE_MINUTES=1440
SLA_LOW_RESOLUTION_MINUTES=4320

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# 'json' for production, 'pretty' for development
LOG_FORMAT=pretty
