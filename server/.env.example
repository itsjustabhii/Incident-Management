# ==============================================================================
# Server .env.example
# Copy to server/.env for local development outside Docker.
# In Docker, values come from the root .env file via docker-compose env_file.
# ==============================================================================

NODE_ENV=development
SERVER_PORT=5000
SERVER_HOST=0.0.0.0

# PostgreSQL — use localhost when running the server outside Docker
DATABASE_URL=postgresql://incident_user:dev_password@localhost:5432/incident_management
TEST_DATABASE_URL=postgresql://incident_user:dev_password@localhost:5432/incident_management_test

# Redis — use localhost when running the server outside Docker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — replace with cryptographically random 64-byte hex values
JWT_ACCESS_SECRET=replace_with_64_byte_random_hex_access
JWT_REFRESH_SECRET=replace_with_64_byte_random_hex_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000

# Uploads
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=./uploads
STORAGE_DRIVER=local

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# SLA defaults (minutes)
SLA_CRITICAL_RESPONSE_MINUTES=60
SLA_CRITICAL_RESOLUTION_MINUTES=240
SLA_HIGH_RESPONSE_MINUTES=240
SLA_HIGH_RESOLUTION_MINUTES=480
SLA_MEDIUM_RESPONSE_MINUTES=480
SLA_MEDIUM_RESOLUTION_MINUTES=1440
SLA_LOW_RESPONSE_MINUTES=1440
SLA_LOW_RESOLUTION_MINUTES=4320

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty
